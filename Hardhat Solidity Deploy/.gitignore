node_modules
.env

# Hardhat files
/cache
/artifacts

# TypeChain files
/typechain
/typechain-types

# solidity-coverage files
/coverage
/coverage.json

# Hardhat Ignition default folder for deployments against a local node
ignition/deployments/chain-31337

# --- Audit Solidity (session audit) ---
# Le .gitignore racine ignore *.sol : on ré-inclut explicitement les sources récupérées depuis build-info
# et les contrats d attaque / mocks de test, sinon ils ne seraient jamais versionnés.
!audit-recovered-contracts/**/*.sol
!test/audit/**/*.sol
# Sorties de compilation de la config d audit (jamais versionnées)
/cache-audit
/artifacts-audit
!audit-src/**/*.sol
!audit-vendor/**/*.sol
